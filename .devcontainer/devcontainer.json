{
  "name": "E. faecalis core-genome environment",
  "image": "mambaorg/micromamba:2.3.2",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "remoteUser": "mambauser",
  "containerEnv": {
    "MAMBA_ROOT_PREFIX": "/opt/conda"
  },
  "postCreateCommand": "bash .devcontainer/setup-core-environment.sh",
  "shutdownAction": "stopContainer"
}